@prefix comet-pcr: <https://comet.carbon/ext/pcr#> .
@prefix comet:      <https://comet.carbon/v1/core#> .
@prefix comet-pcf:  <https://comet.carbon/v1/pcf#> .
@prefix comet-ef:   <https://comet.carbon/v1/emfactor#> .
@prefix comet-sc:   <https://comet.carbon/v1/supplychain#> .
@prefix comet-rs:   <https://comet.carbon/ext/responsiblesteel#> .
@prefix comet-ver:  <https://comet.carbon/v1/ver#> .
@prefix ipcc:       <https://comet.carbon/vocab/ipcc-gwp#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .

#################################################################
# COMET PCR extension (comet-pcr)
#
# A COMET extension namespace for Product Category Rules (PCR) method
# requirements — the normative rules that govern how a Product Carbon Footprint
# is calculated. Follows the COMET extension pattern (cf. comet-rs, comet-cn):
# new terms live in their own namespace and link to COMET core/PCF via SKOS.
#
# Single source of truth for both CarbonSigProductHub/pcrbase (which proposes
# these terms from harvested PCRs) and CarbonSigProductHub/verifier-export
# (which references them). Intended to upstream into Carbonsig/comet-ontology
# as evidence-gated PRs.
#################################################################

<https://comet.carbon/ext/pcr>
    a owl:Ontology ;
    dcterms:title "COMET Product Category Rules (PCR) Extension"@en ;
    dcterms:description "Method-requirement vocabulary for Product Category Rules: the PCR document, its programme operator, declared life-cycle modules, cut-off and allocation rules, and the link from a footprint to its governing PCR. Extends COMET L4 (PCF)."@en ;
    owl:versionInfo "0.2.0" ;
    dcterms:source "ISO 14025", "EN 15804+A2", "EU PEF method", "ISO 14067",
                   "GHG Protocol", "PACT v3", "UNFCCC 7/CP.27" .

#################################################################
# Programme operator
#################################################################

comet-pcr:PCRProgramOperator
    a owl:Class ;
    rdfs:subClassOf schema:Organization ;
    rdfs:label "PCR Programme Operator"@en ;
    skos:definition "The organisation that operates a PCR programme and publishes PCR documents (e.g. EPD International / EnvironDec, EPD Norge, IBU, the European Commission for PEFCRs)."@en ;
    dcterms:source "ISO 14025 §3.5 (programme operator)" .

#################################################################
# The PCR document — reifies COMET's PCRReference stub
#################################################################

comet-pcr:PCRDocument
    a owl:Class ;
    rdfs:label "PCR Document"@en ;
    skos:definition "A published, versioned Product Category Rules document: the set of normative method requirements for declaring the environmental performance of a product category."@en ;
    rdfs:comment "Reifies the single comet-pcf:PCRReference stub into a structured, versioned entity."@en ;
    skos:closeMatch comet-pcf:PCRReference ;
    dcterms:source "ISO 14025 §6.7; EN 15804 §5" .

comet-pcr:program
    a owl:ObjectProperty ;
    rdfs:domain comet-pcr:PCRDocument ;
    rdfs:range comet-pcr:PCRProgramOperator ;
    rdfs:label "programme"@en ;
    skos:definition "The programme operator under which this PCR document is published."@en .

comet-pcr:pcrNumber
    a owl:DatatypeProperty ;
    rdfs:domain comet-pcr:PCRDocument ;
    rdfs:range xsd:string ;
    rdfs:label "PCR number"@en ;
    skos:definition "The programme operator's identifier for the PCR (e.g. 'PCR 2019:14', 'NPCR 020')."@en .

comet-pcr:version
    a owl:DatatypeProperty ;
    rdfs:domain comet-pcr:PCRDocument ;
    rdfs:range xsd:string ;
    rdfs:label "version"@en ;
    skos:definition "The version designator of the PCR document."@en .

comet-pcr:validFrom
    a owl:DatatypeProperty ;
    rdfs:domain comet-pcr:PCRDocument ;
    rdfs:range xsd:date ;
    rdfs:label "valid from"@en ;
    skos:definition "Date from which this PCR version is valid."@en .

comet-pcr:validUntil
    a owl:DatatypeProperty ;
    rdfs:domain comet-pcr:PCRDocument ;
    rdfs:range xsd:date ;
    rdfs:label "valid until"@en ;
    skos:definition "Date on which this PCR version expires."@en .

comet-pcr:scopeCPC
    a owl:DatatypeProperty ;
    rdfs:domain comet-pcr:PCRDocument ;
    rdfs:range xsd:string ;
    rdfs:label "CPC scope code"@en ;
    skos:definition "UN CPC product-classification code(s) delimiting the PCR's product-category scope."@en .

comet-pcr:supersedes
    a owl:ObjectProperty ;
    rdfs:domain comet-pcr:PCRDocument ;
    rdfs:range comet-pcr:PCRDocument ;
    rdfs:label "supersedes"@en ;
    skos:definition "An earlier PCR document, sub-PCR, or c-PCR that this document supersedes or builds on."@en .

#################################################################
# Keystone: link a footprint to its governing PCR
#################################################################

comet-pcr:governedByPCR
    a owl:ObjectProperty ;
    rdfs:domain comet-pcf:ProductCarbonFootprint ;
    rdfs:range comet-pcr:PCRDocument ;
    rdfs:label "governed by PCR"@en ;
    skos:definition "The PCR document whose method requirements govern this product carbon footprint."@en ;
    rdfs:comment "Keystone of the PCR extension: makes a footprint's methodological provenance explicit and machine-checkable."@en .

#################################################################
# Method-requirement classes (SHACL-constraint targets)
#################################################################

comet-pcr:CutOffRule
    a owl:Class ;
    rdfs:label "Cut-off Rule"@en ;
    skos:definition "A criterion (mass, energy, or environmental-significance threshold) below which inputs or outputs may be excluded from the inventory."@en ;
    skos:relatedMatch comet-pcf:SystemBoundary ;
    dcterms:source "ISO 14044 §4.3.3; EN 15804 §6.3.5" .

comet-pcr:DeclaredModule
    a owl:Class ;
    rdfs:label "Declared Life-cycle Module"@en ;
    skos:definition "An EN 15804 life-cycle stage module (A1–A3, A4, A5, B1–B7, C1–C4, D) declared within the system boundary."@en ;
    skos:relatedMatch comet-pcf:SystemBoundary ;
    dcterms:source "EN 15804+A2 §5.2 (modularity)" .

comet-pcr:moduleScheme
    a skos:ConceptScheme ;
    rdfs:label "EN 15804 module scheme"@en ;
    skos:definition "The enumeration of EN 15804 life-cycle modules."@en .

comet-pcr:A1A3 a skos:Concept ; skos:inScheme comet-pcr:moduleScheme ;
    skos:prefLabel "A1–A3 (product stage)"@en .
comet-pcr:D a skos:Concept ; skos:inScheme comet-pcr:moduleScheme ;
    skos:prefLabel "D (benefits and loads beyond the system boundary)"@en .

comet-pcr:ReferenceServiceLife
    a owl:Class ;
    rdfs:label "Reference Service Life"@en ;
    skos:definition "The reference service life (RSL) of a product, used to scenario-scale use-stage modules."@en ;
    dcterms:source "EN 15804+A2 §6.3.3; ISO 15686" .

comet-pcr:ContentDeclaration
    a owl:Class ;
    rdfs:label "Content Declaration"@en ;
    skos:definition "A declaration of product material content, including substances of very high concern (SVHC) under REACH."@en ;
    dcterms:source "EN 15804+A2 §7.4; REACH (EC) 1907/2006" .

comet-pcr:referenceFlow
    a owl:ObjectProperty ;
    rdfs:domain comet-pcf:FunctionalUnit ;
    rdfs:label "reference flow"@en ;
    skos:definition "The reference flow — the quantified product output that realises the functional/declared unit."@en ;
    dcterms:source "ISO 14044 §4.2.3.3" .

#################################################################
# PEF method sub-vocabulary (EU Product Environmental Footprint)
#################################################################

comet-pcr:CircularFootprintFormula
    a owl:Class ;
    rdfs:label "Circular Footprint Formula"@en ;
    skos:definition "The EU PEF Circular Footprint Formula (CFF) governing allocation of recycled content, recycling, and energy recovery."@en ;
    skos:relatedMatch comet-pcf:AllocationMethod ;
    dcterms:source "EU PEF method (Annex II, CFF)" .

comet-pcr:EFImpactCategory
    a owl:Class ;
    rdfs:label "Environmental Footprint Impact Category"@en ;
    skos:definition "One of the 16 EU Environmental Footprint impact categories required by a PEFCR LCIA."@en ;
    skos:relatedMatch comet-pcf:LCIAResult ;
    dcterms:source "EU PEF method (16 EF impact categories)" .

#################################################################
# EPD reporting requirements — how the resulting declaration is
# formatted, compared, and what extra information it must carry.
# Proposed from harvested PCRs (pcrbase); pending evidence-gated upstream.
#################################################################

comet-pcr:EPDLayoutRequirement
    a owl:Class ;
    rdfs:label "EPD Layout Requirement"@en ;
    skos:definition "A normative requirement on the content, structure and layout of the Environmental Product Declaration produced under the PCR."@en ;
    dcterms:source "EN 15804+A2 §5; ISO 14025 §7" .

comet-pcr:DigitalFormatRequirement
    a owl:Class ;
    rdfs:label "Digital Format Requirement"@en ;
    skos:definition "A requirement that the EPD be provided in a machine-readable digital format (e.g. ILCD+EPD, ECO Platform digital EPD)."@en ;
    dcterms:source "EN 15804+A2 §5.2; ECO Platform digital EPD" .

comet-pcr:ComparabilityStatement
    a owl:Class ;
    rdfs:label "Comparability Statement"@en ;
    skos:definition "A statement of the conditions under which EPDs of products may (or may not) be compared, as required by the PCR."@en ;
    dcterms:source "ISO 14025 §5.3; EN 15804+A2 §5.3" .

comet-pcr:AdditionalEnvironmentalInfo
    a owl:Class ;
    rdfs:label "Additional Environmental Information"@en ;
    skos:definition "Additional environmental information the PCR requires or permits beyond the core declared indicators (e.g. hazardous-substance content, VOC emissions)."@en ;
    dcterms:source "EN 15804+A2 §5.4; ISO 14025 §7.2.4" .

#################################################################
# Data quality, background data, and inventory requirements
#################################################################

comet-pcr:DataQualityRequirement
    a owl:Class ;
    rdfs:label "Data Quality Requirement"@en ;
    skos:definition "A requirement on the quality of the underlying life-cycle inventory data, typically expressed as temporal, geographical and technological representativeness."@en ;
    skos:relatedMatch comet-sc:DataQualityIndicator ;
    dcterms:source "EN 15804+A2 §6.3.7; ISO 14044 §4.2.3.6" .

comet-pcr:DataQualityRequirement.temporalRepresentativeness
    a owl:DatatypeProperty ;
    rdfs:domain comet-pcr:DataQualityRequirement ;
    rdfs:range xsd:string ;
    rdfs:label "temporal representativeness"@en ;
    skos:definition "The required temporal representativeness (reference period / maximum age) of the inventory data."@en ;
    dcterms:source "EN 15804+A2 §6.3.7" .

comet-pcr:DataQualityRequirement.geographicalRepresentativeness
    a owl:DatatypeProperty ;
    rdfs:domain comet-pcr:DataQualityRequirement ;
    rdfs:range xsd:string ;
    rdfs:label "geographical representativeness"@en ;
    skos:definition "The required geographical representativeness of the inventory data."@en ;
    dcterms:source "EN 15804+A2 §6.3.7" .

comet-pcr:DataQualityRequirement.technologicalRepresentativeness
    a owl:DatatypeProperty ;
    rdfs:domain comet-pcr:DataQualityRequirement ;
    rdfs:range xsd:string ;
    rdfs:label "technological representativeness"@en ;
    skos:definition "The required technological representativeness of the inventory data."@en ;
    dcterms:source "EN 15804+A2 §6.3.7" .

comet-pcr:BackgroundDatabase
    a owl:Class ;
    rdfs:label "Background Database Requirement"@en ;
    skos:definition "The background life-cycle inventory database(s) the PCR requires or permits for secondary data (e.g. ecoinvent, EF reference package)."@en ;
    dcterms:source "EN 15804+A2 §6.3.6" .

comet-pcr:InventoryFlowRequirement
    a owl:Class ;
    rdfs:label "Inventory Flow Requirement"@en ;
    skos:definition "A requirement to declare resource-use and waste/output-flow inventory indicators (LCI-based parameters) under the PCR."@en ;
    skos:relatedMatch comet-pcr:referenceFlow ;
    dcterms:source "EN 15804+A2 §5.5 (resource use, waste and output flows)" .

comet-pcr:EN15804ImpactSet
    a owl:Class ;
    rdfs:label "EN 15804 Impact Indicator Set"@en ;
    skos:definition "The set of environmental impact indicators required to be declared under EN 15804+A2 (core LCIA indicators)."@en ;
    skos:relatedMatch comet-pcr:EFImpactCategory ;
    dcterms:source "EN 15804+A2 §5.1 (core environmental impact indicators)" .

#################################################################
# Life-cycle scenarios (EN 15804 modules B, C, and transport)
#################################################################

comet-pcr:UseStageScenario
    a owl:Class ;
    rdfs:label "Use-Stage Scenario"@en ;
    skos:definition "Scenario assumptions for the use stage (EN 15804 modules B1–B7) prescribed by the PCR."@en ;
    skos:relatedMatch comet-pcr:DeclaredModule ;
    dcterms:source "EN 15804+A2 §6.4 (modules B1–B7)" .

comet-pcr:EndOfLifeScenario
    a owl:Class ;
    rdfs:label "End-of-Life Scenario"@en ;
    skos:definition "Scenario assumptions for the end-of-life stage (EN 15804 modules C1–C4) prescribed by the PCR."@en ;
    skos:relatedMatch comet-pcr:DeclaredModule ;
    dcterms:source "EN 15804+A2 §6.4 (modules C1–C4)" .

comet-pcr:TransportScenario
    a owl:Class ;
    rdfs:label "Transport Scenario"@en ;
    skos:definition "Transport scenario assumptions (e.g. modules A4 and C2) prescribed by the PCR."@en ;
    skos:relatedMatch comet-sc:TransportEvent ;
    dcterms:source "EN 15804+A2 §6.4 (modules A4, C2)" .

comet-pcr:BiogenicCarbonStatement
    a owl:Class ;
    rdfs:label "Biogenic Carbon Statement"@en ;
    skos:definition "A required declaration of biogenic carbon content and its accounting treatment in the footprint."@en ;
    skos:broadMatch comet-pcf:BiogenicCarbon ;
    dcterms:source "EN 15804+A2 §6.3.4.3 (biogenic carbon)" .

#################################################################
# Independent verification
#################################################################

comet-pcr:ReviewPanel
    a owl:Class ;
    rdfs:label "Review Panel Requirement"@en ;
    skos:definition "A requirement for independent verification / review-panel assurance of the EPD or PCR, as prescribed by the programme."@en ;
    skos:relatedMatch comet-rs:AssurancePanelReview ;
    rdfs:comment "Placed in comet-pcr as a PCR method requirement; the generic verification concept may later live in comet-ver."@en ;
    dcterms:source "ISO 14025 §8 (independent verification)" .

#################################################################
# GWP provenance — value set, basis, confidence, horizon
#
# Four provenance properties on comet-ef:GWP100Value that make a
# characterisation factor's assessment-report basis explicit and recoverable.
# The value SET itself is a member of the ipcc: controlled vocabulary
# (extensions/ipcc-gwp.ttl); these properties CARRY it on a factor.
#
# WHY THIS EXISTS. The prior model — an Enum(AR5, AR6) — could not represent
# AR4 or SAR (both live in regulation and in tradeable credit stock), could not
# distinguish a DECLARED assessment-report basis from an INFERRED one (the
# provenance was lost the moment the number was read), and had no null-safe
# value meaning "indeterminate", so a factor of unknown basis had to assert
# something false or drop out of the graph. These four properties close exactly
# those three gaps, and gwpValueSet keys on the value set (edition + variant)
# rather than the edition label, so it never needs re-widening at AR7.
#
# Placed in comet-pcr as an evidence-gated pending extension; candidate to
# upstream onto comet-ef:GWP100Value in COMET core.
#################################################################

comet-pcr:gwpValueSet
    a owl:ObjectProperty ;
    rdfs:domain comet-ef:GWP100Value ;
    rdfs:range ipcc:GWPValueSet ;
    rdfs:label "GWP value set"@en ;
    skos:definition "The IPCC GWP value set (edition + variant) that produced this factor — a CURIE into the ipcc: controlled vocabulary, e.g. ipcc:AR6-fossilCH4, ipcc:AR5-noFeedback, ipcc:SAR. Supersedes the edition-only enum: absent (null) is legitimate and means the basis is indeterminate, in which case comet-pcr:arBasis MUST be comet-pcr:Indeterminate."@en ;
    rdfs:comment "Replaces the closed Enum(AR5, AR6). Keying on the value set, not the edition, lets COMET describe factors PACT's enum cannot express (SAR, AR4, variant sets); the export layer, not the ontology, decides what each destination accepts."@en ;
    skos:closeMatch comet-ef:GWP100Value.ipccAR ;
    dcterms:source "PACT v3 ipccCharacterizationFactors (extended); GHG Protocol; UNFCCC 7/CP.27" .

comet-pcr:arBasis
    a owl:ObjectProperty ;
    rdfs:domain comet-ef:GWP100Value ;
    rdfs:range comet-pcr:ARBasis ;
    rdfs:label "assessment-report basis"@en ;
    skos:definition "How the value set on this factor was established: declared by the source, arithmetically back-solved from a gas split and CO2e total, inferred by a model, or indeterminate."@en ;
    rdfs:comment "The provenance the enum could not carry. 'Declared' and 'back-solved' are effectively Type-A (determinate); 'inferred' carries comet-pcr:arConfidence; 'indeterminate' is the null-safe case."@en .

comet-pcr:arConfidence
    a owl:DatatypeProperty ;
    rdfs:domain comet-ef:GWP100Value ;
    rdfs:range xsd:decimal ;
    rdfs:label "assessment-report confidence"@en ;
    skos:definition "For the inferred case only: the model's confidence in the assigned value set, in [0,1] (e.g. P(value set | source, vintage, unit, sector, gas hints)). Absent when arBasis is declared or back-solved (both determinate)."@en ;
    dcterms:source "ISO 14067 uncertainty analysis; ecoinvent pedigree matrix" .

comet-pcr:gwpHorizon
    a owl:ObjectProperty ;
    rdfs:domain comet-ef:GWP100Value ;
    rdfs:range comet-pcr:GWPHorizon ;
    rdfs:label "GWP time horizon"@en ;
    skos:definition "The GWP time horizon the factor is stated on (GWP100 or GWP20). Defaults to GWP100. A methane factor near 80 tagged 'GWP-100 AR6' is almost certainly a GWP-20 mislabel — this property makes that anomaly detectable."@en .

comet-pcr:informedByRule
    a owl:ObjectProperty ;
    rdfs:domain comet-ef:GWP100Value ;
    rdfs:range comet-ver:DataSubstitutionRule ;
    rdfs:label "informed by rule"@en ;
    skos:definition "The documented substitution/inference rule (back-solve or model) that assigned the value set, so a verifier receiving the graph sees not just that a basis was assumed but which rule assumed it and with what confidence."@en ;
    rdfs:comment "Links the back-solve/inference method to the factor as a comet-ver:DataSubstitutionRule instance; keeps AR inference inside the existing verification findings workflow."@en .

#################################################################
# arBasis controlled vocabulary
#################################################################

comet-pcr:ARBasis
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Assessment-Report Basis"@en ;
    skos:definition "How a factor's GWP value set was established."@en .

comet-pcr:arBasisScheme
    a skos:ConceptScheme ;
    rdfs:label "AR basis scheme"@en ;
    skos:definition "The enumeration of ways a factor's value set can be established, in decreasing order of determinacy: declared, back-solved, inferred, indeterminate."@en .

comet-pcr:impliedConfidence
    a owl:DatatypeProperty ;
    rdfs:domain comet-pcr:ARBasis ;
    rdfs:range xsd:decimal ;
    rdfs:label "implied confidence"@en ;
    skos:definition "The confidence a basis category implies on its own, in [0,1]. Declared and back-solved are determinate (1.0); inferred carries a per-factor comet-pcr:arConfidence instead; indeterminate has none."@en .

comet-pcr:Declared a comet-pcr:ARBasis, skos:Concept ; skos:inScheme comet-pcr:arBasisScheme ;
    skos:prefLabel "declared"@en ;
    comet-pcr:impliedConfidence 1.0 ;
    skos:definition "The value set is stated by the source (e.g. a machine-readable tag). Determinate."@en .
comet-pcr:BackSolved a comet-pcr:ARBasis, skos:Concept ; skos:inScheme comet-pcr:arBasisScheme ;
    skos:prefLabel "back-solved"@en ;
    comet-pcr:impliedConfidence 1.0 ;
    skos:definition "The value set is arithmetically recovered from the gas split and the CO2e total — the cheapest determinate test, run before any model. Determinate, effectively Type-A. Where a unique solution exists this is evidentially equivalent to a declaration and export gates should treat it as such."@en .
comet-pcr:Inferred a comet-pcr:ARBasis, skos:Concept ; skos:inScheme comet-pcr:arBasisScheme ;
    skos:prefLabel "inferred"@en ;
    skos:definition "The value set is assigned by a model from metadata; carries comet-pcr:arConfidence (below 1) and propagates its own uncertainty. Should link the assigning rule via comet-pcr:informedByRule."@en .
comet-pcr:Indeterminate a comet-pcr:ARBasis, skos:Concept ; skos:inScheme comet-pcr:arBasisScheme ;
    skos:prefLabel "indeterminate"@en ;
    skos:definition "The value set cannot be established. gwpValueSet is absent; the factor is non-declarable into a regulated or PACT channel until resolved."@en .

#################################################################
# GWP time-horizon controlled vocabulary
#################################################################

comet-pcr:GWPHorizon
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "GWP Time Horizon"@en ;
    skos:definition "The integration time horizon of a global warming potential."@en .

comet-pcr:gwpHorizonScheme
    a skos:ConceptScheme ;
    rdfs:label "GWP horizon scheme"@en ;
    skos:definition "The enumeration of GWP time horizons COMET recognises."@en .

comet-pcr:GWP100 a comet-pcr:GWPHorizon, skos:Concept ; skos:inScheme comet-pcr:gwpHorizonScheme ;
    skos:prefLabel "GWP-100 (100-year)"@en ; skos:notation "default" .
comet-pcr:GWP20 a comet-pcr:GWPHorizon, skos:Concept ; skos:inScheme comet-pcr:gwpHorizonScheme ;
    skos:prefLabel "GWP-20 (20-year)"@en .
