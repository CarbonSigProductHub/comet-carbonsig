    comet-match:confidenceLow "0.69"^^xsd:decimal ;
    comet-match:confidenceHigh "0.91"^^xsd:decimal ;
    skos:note "a is the general biogenic carbon content property; b is scoped specifically to packaging per declared unit (TfS field), making a broader and b narrower."@en ;
    comet-match:status "proposed" .

comet-match:proposal-018 a comet-match:MatchProposal ;
    comet-match:subjectTerm <https://comet.carbon/v1/pcf#EmbeddedEmissions.productionRoute> ;
    comet-match:objectTerm <https://comet.carbon/ext/responsiblesteel#productionRoute> ;
    comet-match:relation "exactMatch" ;
    comet-match:confidence "0.82"^^xsd:decimal ;
    comet-match:confidenceLow "0.68"^^xsd:decimal ;
    comet-match:confidenceHigh "0.91"^^xsd:decimal ;
    comet-match:canonicalTerm <https://comet.carbon/v1/pcf#EmbeddedEmissions.productionRoute> ;
    skos:note "Identical labels and identical definition (manufacturing route, BOF/EAF/etc.) in two namespaces; comet-pcf is a published layer while comet-rs is an extension, making comet-pcf the canonical term."@en ;
    comet-match:status "proposed" .

comet-match:proposal-019 a comet-match:MatchProposal ;
    comet-match:subjectTerm <https://comet.carbon/ext/iso14068#retirementDate> ;
    comet-match:objectTerm <https://comet.carbon/v1/eac#RetirementEvent.retirementDate> ;
