comet-match:proposal-016 a comet-match:MatchProposal ;
    comet-match:subjectTerm <https://comet.carbon/v1/core#Site> ;
    comet-match:objectTerm <https://comet.carbon/ext/responsiblesteel#siteAuditBoundary> ;
