    comet-match:confidenceLow "0.73"^^xsd:decimal ;
    comet-match:confidenceHigh "0.93"^^xsd:decimal ;
    skos:note "a is a specific SDG 1 (No Poverty) co-benefit picklist instance; b is the general CoBenefit class — a is a named individual falling under the class, making a narrower."@en ;
