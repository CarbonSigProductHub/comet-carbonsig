@prefix comet-match: <https://comet.carbon/meta/match#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Proposed cross-namespace term matches (status: proposed / human-gated).
# Each is a reviewable proposal, NOT an asserted skos:exactMatch axiom.

comet-match:proposal-000 a comet-match:MatchProposal ;
    comet-match:subjectTerm <https://comet.carbon/ext/responsiblesteel#transfersFrom> ;
    comet-match:objectTerm <https://comet.carbon/ext/responsiblesteel#transfersTo> ;
    comet-match:relation "relatedMatch" ;
    comet-match:confidence "0.92"^^xsd:decimal ;
    comet-match:confidenceLow "0.82"^^xsd:decimal ;
    comet-match:confidenceHigh "0.97"^^xsd:decimal ;
    skos:note "Inverse directional object properties in the same namespace — antonyms expressing opposite directions of the same transfer relationship, not the same concept."@en ;
    comet-match:status "proposed" .

comet-match:proposal-001 a comet-match:MatchProposal ;
    comet-match:subjectTerm <https://comet.carbon/ext/tfs-pcf#AT_FirstParty> ;
    comet-match:objectTerm <https://comet.carbon/ext/tfs-pcf#AT_SecondParty> ;
    comet-match:relation "relatedMatch" ;
    comet-match:confidence "0.9"^^xsd:decimal ;
    comet-match:confidenceLow "0.8"^^xsd:decimal ;
    comet-match:confidenceHigh "0.96"^^xsd:decimal ;
    skos:note "Sibling enumeration individuals in the same audit-type classification: 1st-party vs 2nd-party PCF verification — same classification axis, distinct values."@en ;
    comet-match:status "proposed" .

comet-match:proposal-002 a comet-match:MatchProposal ;
    comet-match:subjectTerm <https://comet.carbon/ext/tfs-pcf#AT_FirstParty> ;
    comet-match:objectTerm <https://comet.carbon/ext/tfs-pcf#AT_ThirdParty> ;
    comet-match:relation "relatedMatch" ;
    comet-match:confidence "0.9"^^xsd:decimal ;
    comet-match:confidenceLow "0.8"^^xsd:decimal ;
    comet-match:confidenceHigh "0.96"^^xsd:decimal ;
    skos:note "Sibling enumeration individuals: 1st-party vs 3rd-party PCF verification — same classification axis, distinct values."@en ;
    comet-match:status "proposed" .

comet-match:proposal-003 a comet-match:MatchProposal ;
    comet-match:subjectTerm <https://comet.carbon/ext/tfs-pcf#AT_SecondParty> ;
    comet-match:objectTerm <https://comet.carbon/ext/tfs-pcf#AT_ThirdParty> ;
    comet-match:relation "relatedMatch" ;
    comet-match:confidence "0.9"^^xsd:decimal ;
    comet-match:confidenceLow "0.8"^^xsd:decimal ;
    comet-match:confidenceHigh "0.96"^^xsd:decimal ;
    skos:note "Sibling enumeration individuals: 2nd-party vs 3rd-party PCF verification — same classification axis, distinct values."@en ;
    comet-match:status "proposed" .

comet-match:proposal-004 a comet-match:MatchProposal ;
    comet-match:subjectTerm <https://comet.carbon/ext/tfs-pcf#productVerificationShare1stParty> ;
    comet-match:objectTerm <https://comet.carbon/ext/tfs-pcf#productVerificationShare2ndParty> ;
    comet-match:relation "relatedMatch" ;
    comet-match:confidence "0.88"^^xsd:decimal ;
    comet-match:confidenceLow "0.77"^^xsd:decimal ;
    comet-match:confidenceHigh "0.95"^^xsd:decimal ;
    skos:note "Parallel datatype properties measuring product verification share for different parties (1PVS vs 2PVS); same structural role, distinct party-scope — not interchangeable."@en ;
    comet-match:status "proposed" .

comet-match:proposal-005 a comet-match:MatchProposal ;
    comet-match:subjectTerm <https://comet.carbon/ext/tfs-pcf#productVerificationShare1stParty> ;
    comet-match:objectTerm <https://comet.carbon/ext/tfs-pcf#productVerificationShare3rdParty> ;
    comet-match:relation "relatedMatch" ;
    comet-match:confidence "0.88"^^xsd:decimal ;
    comet-match:confidenceLow "0.77"^^xsd:decimal ;
    comet-match:confidenceHigh "0.95"^^xsd:decimal ;
    skos:note "Parallel datatype properties for 1PVS vs 3PVS; same structural role across different party scopes."@en ;
    comet-match:status "proposed" .

comet-match:proposal-006 a comet-match:MatchProposal ;
    comet-match:subjectTerm <https://comet.carbon/ext/tfs-pcf#productVerificationShare2ndParty> ;
    comet-match:objectTerm <https://comet.carbon/ext/tfs-pcf#productVerificationShare3rdParty> ;
    comet-match:relation "relatedMatch" ;
    comet-match:confidence "0.88"^^xsd:decimal ;
    comet-match:confidenceLow "0.77"^^xsd:decimal ;
    comet-match:confidenceHigh "0.95"^^xsd:decimal ;
    skos:note "Parallel datatype properties for 2PVS vs 3PVS; same structural role across different party scopes."@en ;
    comet-match:status "proposed" .

comet-match:proposal-007 a comet-match:MatchProposal ;
    comet-match:subjectTerm <https://cadtrust.org/dd#co_benefit.cadTrustProjectId> ;
    comet-match:objectTerm <https://comet.carbon/v1/ver#CADTrustAttestation.cadTrustProjectId> ;
    comet-match:relation "exactMatch" ;
    comet-match:confidence "0.88"^^xsd:decimal ;
    comet-match:confidenceLow "0.75"^^xsd:decimal ;
    comet-match:confidenceHigh "0.96"^^xsd:decimal ;
    comet-match:canonicalTerm <https://comet.carbon/v1/ver#CADTrustAttestation.cadTrustProjectId> ;
    skos:note "Both are the CAD Trust project GUID — identical label, identical definition, both are identifiers for the same CAD Trust project entity; comet-ver is a more published layer so it is preferred as canonical."@en ;
    comet-match:status "proposed" .

comet-match:proposal-008 a comet-match:MatchProposal ;
    comet-match:subjectTerm <https://cadtrust.org/dd#estimation.cadTrustProjectId> ;
    comet-match:objectTerm <https://comet.carbon/v1/ver#CADTrustAttestation.cadTrustProjectId> ;
    comet-match:relation "exactMatch" ;
    comet-match:confidence "0.88"^^xsd:decimal ;
    comet-match:confidenceLow "0.75"^^xsd:decimal ;
    comet-match:confidenceHigh "0.96"^^xsd:decimal ;
    comet-match:canonicalTerm <https://comet.carbon/v1/ver#CADTrustAttestation.cadTrustProjectId> ;
    skos:note "Both are the CAD Trust project GUID with identical label and definition; the comet-ver instance is the more foundational published-layer definition."@en ;
    comet-match:status "proposed" .

comet-match:proposal-009 a comet-match:MatchProposal ;
    comet-match:subjectTerm <https://comet.carbon/v1/core#Material> ;
    comet-match:objectTerm <https://comet.carbon/ext/responsiblesteel#RSInputMaterial> ;
    comet-match:relation "broadMatch" ;
    comet-match:confidence "0.88"^^xsd:decimal ;
    comet-match:confidenceLow "0.78"^^xsd:decimal ;
    comet-match:confidenceHigh "0.95"^^xsd:decimal ;
    skos:note "RSInputMaterial is a domain-constrained subtype of Material scoped to ResponsibleSteel Annex 1 ferrous inputs; comet:Material is the general input/output substance concept that encompasses it."@en ;
    comet-match:status "proposed" .

comet-match:proposal-010 a comet-match:MatchProposal ;
    comet-match:subjectTerm <https://comet.carbon/ext/iso14068#Baseline> ;
    comet-match:objectTerm <https://comet.carbon/ext/responsiblesteel#ProcessGasBaseline> ;
    comet-match:relation "broadMatch" ;
    comet-match:confidence "0.87"^^xsd:decimal ;
    comet-match:confidenceLow "0.77"^^xsd:decimal ;
    comet-match:confidenceHigh "0.94"^^xsd:decimal ;
    skos:note "comet-cn:Baseline is the ISO 14068-1 general concept of quantified GHG emissions for a base period; ProcessGasBaseline is a highly specific counterfactual baseline restricted to captured process gases in steelmaking CCUS credits."@en ;
    comet-match:status "proposed" .

comet-match:proposal-011 a comet-match:MatchProposal ;
    comet-match:subjectTerm <https://comet.carbon/v1/emfactor#GWP100Value> ;
    comet-match:objectTerm <https://comet.carbon/v1/emfactor#GWP100Value.gwpValue> ;
    comet-match:relation "narrowMatch" ;
    comet-match:confidence "0.85"^^xsd:decimal ;
    comet-match:confidenceLow "0.74"^^xsd:decimal ;
    comet-match:confidenceHigh "0.93"^^xsd:decimal ;
    skos:note "GWP100Value is the class representing a GWP100 measurement object; gwpValue is the datatype property slot carrying the numeric factor on that class — a is broader than b."@en ;
    comet-match:status "proposed" .

comet-match:proposal-012 a comet-match:MatchProposal ;
    comet-match:subjectTerm <https://cadtrust.org/dd/pick#co_benefit_id.SDG%201%20-%20No%20poverty> ;
