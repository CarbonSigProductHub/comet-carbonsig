    comet-match:confidenceLow "0.7"^^xsd:decimal ;
    comet-match:confidenceHigh "0.91"^^xsd:decimal ;
    comet-match:canonicalTerm <https://comet.carbon/v1/eac#RetirementEvent.retirementDate> ;
    skos:note "Both record the calendar date of a retirement event; they differ in domain context (carbon neutrality claim vs. EAC retirement) but represent the same temporal data point, with the EAC term residing in the more foundational published layer."@en ;
    comet-match:status "proposed" .

comet-match:proposal-020 a comet-match:MatchProposal ;
    comet-match:subjectTerm <https://comet.carbon/v1/core#TimePeriod.endDate> ;
