    comet-match:confidenceLow "0.75"^^xsd:decimal ;
    comet-match:confidenceHigh "0.93"^^xsd:decimal ;
    skos:note "comet:Site is the concept of a physical facility, while siteAuditBoundary is a descriptive property of the boundary defined at certification time — the class is broader than the attribute it subsumes."@en ;
    comet-match:status "proposed" .

comet-match:proposal-017 a comet-match:MatchProposal ;
    comet-match:subjectTerm <https://comet.carbon/v1/pcf#BiogenicCarbon.biogenicCarbonContent> ;
