@prefix comet:      <https://comet.carbon/v1/core#> .
@prefix comet-eac:  <https://comet.carbon/v1/eac#> .
@prefix comet-ver:  <https://comet.carbon/v1/ver#> .
@prefix comet-irec: <https://comet.carbon/ext/irec-e#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:         <https://example.org/irec/> .

# Worked example: a 45 MW biomass + coal co-firing plant in Thailand submitting
# an Issue Request for one month. Only the renewable (biomass) share of energy
# is I-REC(E)-eligible, computed via SF-04C per-fuel calorific allocation.

# ─── Entities & Account ──────────────────────────────────────────────────
ex:GreenPowerCo a comet-irec:Registrant ;
    comet:Organization.orgName "Green Power Company Ltd" ;
    comet:Organization.orgId "TH-ORG-00412" .

ex:BuyerCorp a comet-irec:Participant ;
    comet:Organization.orgName "Bangkok Manufacturing PCL" ;
    comet:Organization.orgId "TH-ORG-01987" .

ex:TradeAcct a comet-irec:Account ;
    comet-irec:accountId "TH-ACC-0421-T" ;
    comet-irec:accountType "Trade" ;
    comet-irec:accountHolder ex:GreenPowerCo .

ex:RedemptionAcct a comet-irec:Account ;
    comet-irec:accountId "TH-ACC-1987-R" ;
    comet-irec:accountType "Redemption" ;
    comet-irec:accountHolder ex:BuyerCorp .

# ─── Production Facility (SF-02) ─────────────────────────────────────────
ex:RayongCoFiring a comet-irec:ProductionFacility ;
    comet:Site.siteName "Rayong Co-firing Plant" ;
    comet:Site.siteCountry "TH" ;
    comet:Site.siteGIS "12.6810,101.2789" ;
    comet-irec:installedCapacityMW "45.0"^^xsd:decimal ;
    comet-irec:numberOfGeneratingUnits 1 ;
    comet-irec:commissioningDate "2019-06-01"^^xsd:date ;
    comet-irec:effectiveRegistrationDate "2024-07-01"^^xsd:date ;
    comet-irec:meterId "TH-MTR-RAYONG-01" ;
    comet-irec:technologyCode "TC110" ;
    comet-irec:fuelCode "ES200" ;
    comet-irec:gridConnectionVoltage "115 kV" ;
    comet-irec:networkOwner "Provincial Electricity Authority (PEA)" ;
    comet-irec:captiveConsumerPresent false ;
    comet-irec:publicFundingType "None" ;
    comet-irec:expectedVolumeEvidence "Metering data" ;
    comet-irec:facilityOwner ex:GreenPowerCo ;
    comet-irec:verifiedByAgent ex:TUVAgent ;
    comet-irec:definedByForm comet-irec:SF-02 .

ex:TUVAgent a comet-irec:VerificationAgent ;
    comet-ver:QualifiedVerifier.verifierName "TÜV SÜD (Thailand)" .

# ─── Production Period (reused comet:TimePeriod) ─────────────────────────
ex:Period202506 a comet:TimePeriod ;
    comet:TimePeriod.startDate "2025-06-01"^^xsd:date ;
    comet:TimePeriod.endDate   "2025-06-30"^^xsd:date .

# ─── Fuel Consumption Statement (SF-04C) ─────────────────────────────────
# Biomass: GCV 15 MJ/kg, consumed 8,000,000 kg  -> 120,000,000 MJ (renewable)
# Coal:    GCV 27 MJ/kg, consumed 1,000,000 kg  ->  27,000,000 MJ (non-renewable)
# Renewable share = 120,000,000 / 147,000,000 = 81.63%
# Total metered production 5,000 MWh  ->  eligible = 4,081.632653 MWh
ex:FCS202506 a comet-irec:FuelConsumptionStatement ;
    comet-irec:measurementUnit "MWh" ;
    comet-irec:hasFuelInput ex:FuelBiomass, ex:FuelCoal ;
    comet-irec:definedByForm comet-irec:SF-04C .

ex:FuelBiomass a comet-irec:FuelInputRecord ;
    rdfs:label "Agricultural residue biomass" ;
    comet-irec:fuelCode "ES200" ;
    comet-irec:isRenewableSource true ;
    comet-irec:grossCalorificValueMJkg "15.0"^^xsd:decimal ;
    comet-irec:stockBalanceStartKg "500000.0"^^xsd:decimal ;
    comet-irec:stockAddedKg "8200000.0"^^xsd:decimal ;
    comet-irec:stockBalanceEndKg "700000.0"^^xsd:decimal ;
    comet-irec:fuelConsumedKg "8000000.0"^^xsd:decimal ;
    comet-irec:energyFromSourceMJ "120000000.0"^^xsd:decimal .

ex:FuelCoal a comet-irec:FuelInputRecord ;
    rdfs:label "Sub-bituminous coal" ;
    comet-irec:fuelCode "FF100" ;
    comet-irec:isRenewableSource false ;
    comet-irec:grossCalorificValueMJkg "27.0"^^xsd:decimal ;
    comet-irec:stockBalanceStartKg "300000.0"^^xsd:decimal ;
    comet-irec:stockAddedKg "1000000.0"^^xsd:decimal ;
    comet-irec:stockBalanceEndKg "300000.0"^^xsd:decimal ;
    comet-irec:fuelConsumedKg "1000000.0"^^xsd:decimal ;
    comet-irec:energyFromSourceMJ "27000000.0"^^xsd:decimal .

# ─── Issue Request (SF-04) ───────────────────────────────────────────────
ex:IR202506 a comet-irec:IssueRequest ;
    comet-irec:requestType "Normal" ;
    comet-irec:requestsFacility ex:RayongCoFiring ;
    comet-irec:hasProductionPeriod ex:Period202506 ;
    comet-irec:totalProductionMWh "5000.0"^^xsd:decimal ;
    comet-irec:amountAppliedForMWh "4081.632653"^^xsd:decimal ;
    comet-irec:evidenceType "SettlementMetering" ;
    comet-irec:hasFuelConsumptionStatement ex:FCS202506 ;
    comet-irec:receivingAccount ex:TradeAcct ;
    comet-irec:reviewedByAuditor ex:TUVAgent ;
    comet-irec:hasDeclaration ex:IssuingDecl202506 ;
    comet-irec:definedByForm comet-irec:SF-04 .

ex:IssuingDecl202506 a comet-irec:IssuingDeclaration ;
    rdfs:label "SF-04A Issuing Declaration for IR202506 — energy not submitted to any other scheme" ;
    comet-irec:definedByForm comet-irec:SF-04A .

# ─── I-REC(E) Certificate (comet-eac:EnergyAttributeCert) ────────────────
ex:CertBatch202506 a comet-irec:IRECCertificate ;
    comet-eac:EAC.serialNumber "TH-IREC-2025-06-000001-to-4081" ;
    comet-eac:EAC.issueDate "2025-07-15"^^xsd:date ;
    comet-eac:EAC.unitCount "4081.632653"^^xsd:decimal ;
    comet-eac:EAC.unitStatus "active" ;
    comet-eac:EAC.vintageYear 2025 ;
    comet-eac:EAC.registry ex:EvidentRegistry ;
    comet-irec:generatedByFacility ex:RayongCoFiring ;
    comet-irec:fromIssueRequest ex:IR202506 ;
    comet-irec:heldInAccount ex:TradeAcct ;
    comet-irec:chainOfCustodyReference "TH-IREC-COC-RAYONG-202506-0001" ;
    comet-irec:carbonOffsetRightsExcluded false ;
    comet-irec:redemptionStatement ex:Redemption202506 .

ex:EvidentRegistry a comet-eac:CertificateRegistry ;
    comet-eac:CertificateRegistry.registryName "I-REC" ;
    comet-eac:CertificateRegistry.programName "Evident I-REC Standard for Electricity" .

# ─── Redemption Statement (Code s.10) ────────────────────────────────────
ex:Redemption202506 a comet-irec:RedemptionStatement ;
    comet-eac:RetirementEvent.retirementBeneficiary "Bangkok Manufacturing PCL" ;
    comet-eac:RetirementEvent.retirementDate "2025-08-02"^^xsd:date ;
    comet-irec:redemptionPurpose "Scope 2 market-based emissions matching, FY2025" ;
    comet-irec:qrCode "https://redemption.evident.global/verify/TH-IREC-2025-06-000001"^^xsd:anyURI ;
    comet-irec:verificationKey "9f8b-2a1c-77de-4410" .
